.git
# Secrets an operator's checkout may hold anywhere: the sandbox image copies whole folders
# (its source stage), which every run can read.
**/.env
**/.env.*
**/*.pem
**/*.key
test
dashboard/node_modules
dashboard/dist
listener/vendor/node_modules
# The docs site's build: the sandbox image copies docs/ for its pages alone.
docs/node_modules
docs/.vitepress
docs/package.json
docs/package-lock.json
listener/vendor/graphql.mjs
# The docs' pictures (dashboard/screenshots/): the sandbox image copies docs/, and no run reads them.
docs/images
