# Copy to .env (git-ignored) and fill in the first two.
ALLOWED_USERS=your-github-login
# From `claude setup-token` (your Claude plan), or ANTHROPIC_API_KEY instead.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Optional.
# The release to run (a tag without its "v": 1.2.3, or 1.2), or latest. Pin it to update
# with Renovate; leave it to update with `docker compose pull && docker compose up -d`.
DECKHAND_VERSION=latest
PUBLIC_URL=
ALLOWED_REPOS=
# Hosts every sandbox may reach besides Anthropic and GitHub (comma-separated; *.domain, *).
ALLOWED_HOSTS=
# Each sandbox's limits.
SANDBOX_CPUS=2
SANDBOX_MEMORY=4g
SANDBOX_PIDS=2048
