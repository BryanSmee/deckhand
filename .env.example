# Copy to .env (git-ignored) and fill in a Claude credential and ALLOWED_USERS. The other settings can go in
# server/config.yaml instead (server.example/); a value set here wins over the file's.
# From `claude setup-token` (your Claude plan), or ANTHROPIC_API_KEY instead, or
# ANTHROPIC_AUTH_TOKEN for a gateway such as OpenRouter (docs/setup.md#through-a-gateway).
# A plan is usually licensed to one person: serving a team, or repositories other people write
# to, may break your provider's terms. You are responsible for how Deckhand uses it; for teams,
# use an API key. With both a plan and a key, runs start on the plan: FALLBACKS=claude@anthropic:key
# moves them to the key when the plan's limit is reached (docs/setup.md#fallbacks).
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
# Codex's OpenAI API key, to run Codex (sandbox_agent: codex, or a repo's agent: codex) instead
# of or besides Claude Code (docs/setup.md#codex).
OPENAI_API_KEY=
# Or a ChatGPT plan's login for Codex, which the models service holds and refreshes: the
# auth.json from `codex login`, as credentials/codex-auth.json, needs nothing here; this variable
# points elsewhere, a file the models service can read (docs/setup.md#with-a-chatgpt-plan). A ChatGPT plan is usually licensed to one person too:
# serving a team, or repositories other people write to, may break OpenAI's terms. You are
# responsible for how Deckhand uses it; for teams, use an API key.
CODEX_AUTH_FILE=
# The Antigravity CLI's Gemini API key, to run it (sandbox_agent: antigravity, or a repo's
# agent: antigravity) instead of or besides Claude Code (docs/setup.md#antigravity-cli).
GEMINI_API_KEY=
# Or a Google AI Pro/Ultra plan's login for the Antigravity CLI, which the models service holds
# and refreshes: the token file `agy` writes when you sign in, as credentials/agy-auth.json, needs
# nothing here; this variable points elsewhere, a file the models service can read
# (docs/setup.md#with-a-google-ai-plan). A plan is licensed to one person, and Google's terms
# may not allow it to drive a bot: check them. You are responsible for how Deckhand uses it;
# for teams, use an API key.
AGY_AUTH_FILE=
# An OpenRouter key, for claude@openrouter in FALLBACKS: where runs go when Anthropic fails
# (docs/setup.md#fallbacks).
OPENROUTER_API_KEY=
# GitHub logins allowed to start runs (comma-separated): here, or allowed_users in
# config.yaml. Required from one or the other.
ALLOWED_USERS=

# Optional, read by compose.yaml itself.
# The release to run (a tag without its "v": 1.2.3, or 1.2), or latest. Pin it to update
# with Renovate; leave it to update with `docker compose pull && docker compose up -d`.
DECKHAND_VERSION=latest
# The folder mounted at /etc/deckhand: config.yaml and grants/ (docs/setup.md#the-server-folder).
# DECKHAND_SERVER_DIR=./server
# The folder mounted read only at /data/credentials in the models service: the plans' logins it
# refreshes, keeping the refreshed ones in its store (docs/setup.md#the-credentials-folder).
# DECKHAND_CREDENTIALS_DIR=./credentials
# A container engine for repositories you grant `docker` (docs/setup.md#container-engine):
# set SANDBOX_ENGINE (sysbox, podman or auto) and pull its images with the engine profile.
# SANDBOX_ENGINE=sysbox
# COMPOSE_PROFILES=engine
# The subnets of the internal networks between the broker service and its callers, which it
# tells them apart by (docs/setup.md#the-broker-service): change them if the host uses these.
# BROKER_ORCHESTRATOR_SUBNET=10.231.250.0/28
# BROKER_EDGE_SUBNET=10.231.250.208/28
# BROKER_PROXY_SUBNET=10.231.250.16/28
# BROKER_RUNNER_SUBNET=10.231.250.32/28
# BROKER_MODELS_SUBNET=10.231.250.64/28
# BROKER_GITHUB_SUBNET=10.231.250.176/28
# The subnets of the internal networks between the models service and its callers (the egress
# proxy, the orchestrator), and between it and the runner (docs/setup.md#the-models-service).
# MODELS_PROXY_SUBNET=10.231.250.80/28
# MODELS_ORCHESTRATOR_SUBNET=10.231.250.96/28
# RUNNER_MODELS_SUBNET=10.231.250.112/28
# The same for the github service and its callers (docs/setup.md#the-github-service).
# GITHUB_ORCHESTRATOR_SUBNET=10.231.250.128/28
# GITHUB_EDGE_SUBNET=10.231.250.224/28
# GITHUB_PROXY_SUBNET=10.231.250.144/28
# GITHUB_RUNNER_SUBNET=10.231.250.160/28
# The subnet of the internal network between the orchestrator and the runner, which each tells
# the other by (docs/setup.md#advanced-settings), and of edge's to the orchestrator: change them
# if the host uses them.
# RUNNER_SUBNET=10.231.250.48/28
# EDGE_ORCHESTRATOR_SUBNET=10.231.250.192/28
