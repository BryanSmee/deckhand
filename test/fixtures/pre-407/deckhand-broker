#!/bin/bash
# Fixture: sandbox/deckhand-broker as it was before #407, which the old gh calls.
# Calls the listener's broker (../listener/broker.mjs) as this run: deckhand-broker <path>
# [curl options…] prints its answer and exits with curl's status. The gh wrapper's pull request
# commands go through it.
set -euo pipefail
: "${DECKHAND_BROKER_URL:?not a Deckhand run: no broker}"
: "${DECKHAND_RUN_SECRET:?not a Deckhand run: no run secret}"
path=$1
shift
# The secret goes through a header file on stdin, so it never shows in `ps`.
exec curl "$@" -H @- "$DECKHAND_BROKER_URL/$path" <<< "Authorization: Bearer $DECKHAND_RUN_SECRET"
