#!/bin/bash
# Prints what this run gives GitHub in place of a token: its secret. The egress proxy relays
# its GitHub calls to the listener's GitHub gateway (../listener/github-gateway.mjs), which
# swaps it for a token limited to the run's repo that the sandbox never sees, while the run
# lasts. The git credential helper and the gh wrapper call it.
set -euo pipefail
: "${DECKHAND_RUN_SECRET:?not a Deckhand run: no run secret}"
printf '%s\n' "$DECKHAND_RUN_SECRET"
