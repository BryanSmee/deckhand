#!/bin/bash
# Prints what this run gives GitHub in place of a token: its run token, a JWT the broker service
# signs (../broker/runs.mjs), bound to this sandbox and valid for 15 minutes. The egress proxy
# relays its GitHub calls to the github service's GitHub gateway
# (../listener/github-gateway.mjs), which swaps it for a token limited to the run's repo that
# the sandbox never sees, while the run lasts. The git credential helper and the gh wrapper call it
# each time: the token changes, so nothing may keep it.
#
#   deckhand-token          prints the token, from DECKHAND_TOKEN_FILE
#   deckhand-token --header  the `Authorization` header's value for the broker's own endpoints
#                           (`Bearer <token>`, deckhand-files and deckhand-inbox): empty after
#                           `Bearer` outside a run, which the broker refuses
#   deckhand-token --init   writes DECKHAND_RUN_TOKEN, the first token, to DECKHAND_TOKEN_FILE
#                           (entrypoint.sh)
#   deckhand-token --now    renews it once, at once (entrypoint.sh, before the run's first
#                           call): the first token was signed when the sandbox was created, which
#                           may be long before it starts (a pod Pending while its image pulls or
#                           its agent installs). The broker takes an expired one from its sandbox
#                           (../broker/runs.mjs renew()), and gives back the same one when it
#                           was signed less than a minute ago
#   deckhand-token --renew  asks the broker for a new one every DECKHAND_TOKEN_RENEW seconds
#                           (300), presenting the current one, and replaces the file whole,
#                           until the sandbox stops (entrypoint.sh, in the background). A
#                           failure is said on stderr, and asked again after
#                           DECKHAND_TOKEN_RETRY seconds (30). The first time after
#                           DECKHAND_TOKEN_FIRST seconds when set (entrypoint.sh: --now failed)
set -euo pipefail
file=${DECKHAND_TOKEN_FILE:-/dev/shm/deckhand/run-token}
JWT='^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$'

# The file replaced whole, owner-only: a reader never sees half a token.
write() {
  [[ $1 =~ $JWT ]] || return 1
  mkdir -p -m 700 "$(dirname "$file")"
  (umask 077 && printf '%s\n' "$1" > "$file.part")
  mv -f "$file.part" "$file"
}

# A new token for the current one (POST /run/token). The token goes on stdin, not the command
# line, where ps shows it.
renew() {
  local token new
  token=$(< "$file") || return 1
  new=$(printf 'Authorization: Bearer %s\n' "$token" |
    curl -fsS --max-time 30 -X POST -H @- "$DECKHAND_BROKER_URL/run/token") || return 1
  write "$new"
}

case "${1:-}" in
  --init)
    : "${DECKHAND_RUN_TOKEN:?no run token to write}"
    write "$DECKHAND_RUN_TOKEN" || {
      echo "deckhand-token: DECKHAND_RUN_TOKEN isn't a run token" >&2
      exit 1
    }
    ;;
  --header)
    token=$("$0" 2> /dev/null) || token=
    printf 'Bearer %s\n' "$token"
    ;;
  --now)
    : "${DECKHAND_BROKER_URL:?no broker to renew the run token with}"
    renew || {
      echo "deckhand-token: the run token couldn't be renewed" >&2
      exit 1
    }
    ;;
  --renew)
    : "${DECKHAND_BROKER_URL:?no broker to renew the run token with}"
    every=${DECKHAND_TOKEN_RENEW:-300}
    wait=${DECKHAND_TOKEN_FIRST:-$every}
    while sleep "$wait"; do
      if renew; then
        wait=$every
      else
        wait=${DECKHAND_TOKEN_RETRY:-30}
        echo "deckhand-token: the run token couldn't be renewed, asking again in $wait s" >&2
      fi
    done
    ;;
  "")
    if [ ! -f "$file" ]; then
      echo "deckhand-token: not a Deckhand run: no run token" >&2
      exit 1
    fi
    printf '%s\n' "$(< "$file")"
    ;;
  *)
    echo "usage: deckhand-token [--header | --init | --now | --renew]" >&2
    exit 2
    ;;
esac
