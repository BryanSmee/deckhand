#!/bin/bash
# git credential helper: answers `get` for the repo's host with a token from the broker
# (deckhand-token), as the user GitHub expects for App tokens. Nothing is stored, so `store`
# and `erase` do nothing. Outside a Deckhand run it stays silent and git asks elsewhere.
[ "${1:-}" = get ] || exit 0
host=
while IFS='=' read -r key value; do
  [ -n "$key" ] || break
  [ "$key" = host ] && host=$value
done
# Only the host the repo was cloned from (REPO_URL): the token is for it alone.
expected=$(sed -E 's#^https?://([^/]+)/.*#\1#' <<< "${REPO_URL:-https://github.com/}")
[ "$host" = "$expected" ] || exit 0
[ -n "${DECKHAND_BROKER_URL:-}" ] || exit 0
token=$(deckhand-token) || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
