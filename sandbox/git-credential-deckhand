#!/bin/bash
# git credential helper: answers `get` for the repo's host with a token from the broker
# (deckhand-token), as the user GitHub expects for App tokens. That token only reads: pushes
# go to the listener's git gateway (entrypoint.sh's pushInsteadOf), and for the broker's host
# the helper answers with the run's secret instead. Nothing is stored, so `store` and `erase`
# do nothing. Outside a Deckhand run it stays silent and git asks elsewhere.
[ "${1:-}" = get ] || exit 0
host=
while IFS='=' read -r key value; do
  [ -n "$key" ] || break
  [ "$key" = host ] && host=$value
done
[ -n "${DECKHAND_BROKER_URL:-}" ] || exit 0
host_of() { sed -E 's#^https?://([^/]+).*#\1#' <<< "$1"; }
if [ "$host" = "$(host_of "$DECKHAND_BROKER_URL")" ]; then
  [ -n "${DECKHAND_RUN_SECRET:-}" ] || exit 0
  printf 'username=deckhand\npassword=%s\n' "$DECKHAND_RUN_SECRET"
  exit 0
fi
# Only the host the repo was cloned from (REPO_URL): the token is for it alone.
[ "$host" = "$(host_of "${REPO_URL:-https://github.com/}")" ] || exit 0
token=$(deckhand-token) || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
