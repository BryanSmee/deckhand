#!/bin/bash
# git credential helper: answers `get` with the run's secret (deckhand-token), for the host the
# repo was cloned from and for the broker's. GitHub's calls go through the listener's GitHub
# gateway (the egress proxy relays them), which swaps it for a token; pushes go to its git
# gateway (entrypoint.sh's pushInsteadOf), which takes it as is. Nothing is stored, so `store`
# and `erase` do nothing. Outside a Deckhand run it stays silent and git asks elsewhere.
[ "${1:-}" = get ] || exit 0
host=
while IFS='=' read -r key value; do
  [ -n "$key" ] || break
  [ "$key" = host ] && host=$value
done
[ -n "${DECKHAND_BROKER_URL:-}" ] || exit 0
host_of() { sed -E 's#^https?://([^/]+).*#\1#' <<< "$1"; }
if [ "$host" = "$(host_of "$DECKHAND_BROKER_URL")" ]; then
  user=deckhand
# Only the host the repo was cloned from (REPO_URL), as GitHub expects an App's token there.
elif [ "$host" = "$(host_of "${REPO_URL:-https://github.com/}")" ]; then
  user=x-access-token
else
  exit 0
fi
secret=$(deckhand-token 2> /dev/null) || exit 0
printf 'username=%s\npassword=%s\n' "$user" "$secret"
