#!/bin/bash
# Installs Claude Code CLAUDE_CODE_VERSION into the shared /opt/claude-code volume, once:
# the listener runs it in a container of its own before the first run that needs that
# version, and entrypoint.sh again as a fallback (a sandbox started by hand). No image ships
# Claude Code.
#
# One folder per version, installed aside then renamed, so two installs at once can't leave
# a half-installed copy behind.
set -euo pipefail

: "${CLAUDE_CODE_VERSION:?CLAUDE_CODE_VERSION: the Claude Code version to install}"

home=/opt/claude-code/$CLAUDE_CODE_VERSION
[ -x "$home/node_modules/.bin/claude" ] && exit 0
tmp=$(mktemp -d /opt/claude-code/.install-XXXXXX)
npm install --prefix "$tmp" --no-fund --no-audit --loglevel=error \
  "@anthropic-ai/claude-code@$CLAUDE_CODE_VERSION" > /tmp/claude-install.log 2>&1 ||
  { cat /tmp/claude-install.log >&2; rm -rf "$tmp"; exit 1; }
mv -T "$tmp" "$home" 2> /dev/null || rm -rf "$tmp" # another install got there first
echo "Claude Code $CLAUDE_CODE_VERSION installed" >&2
